{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_github}"
  },
  "license": "${mod_license}",
  "icon": "icon.png",
  "accessWidener": "sleep_tight.accesswidener",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.mehvahdjukaar.sleep_tight.platform.SleepTightFabric"
    ],
    "modmenu": [
      "net.mehvahdjukaar.sleep_tight.integration.fabric.ModMenuCompat"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}-common.mixins.json"
  ],
  "depends": {
    "fabric": "*",
    "minecraft": "=${minecraft_version}",
    "moonlight": ">=${moonlight_min_version}"
  }
}